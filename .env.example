# GEMINI_API_KEY: Required for Gemini AI API calls (server-side proxy).
GEMINI_API_KEY="your-gemini-api-key"
VITE_GEMINI_API_KEY="your-gemini-api-key"

# Supabase Configuration — get these from your Supabase project's
# Settings -> API page after creating a project at https://supabase.com
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY=""

# APP_URL: The URL where this app is hosted (used for OAuth callbacks etc.)
APP_URL="http://localhost:5173"


