rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------
    // HELPERS
    // ---------------------------------------------------------
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Helper to get class data
    function getClass(classId) {
      return get(/databases/$(database)/documents/classes/$(classId)).data;
    }

    function isTeacherOfClass(classId) {
      return isSignedIn() && getClass(classId).teacherId == request.auth.uid;
    }

    function isStudentInClass(classId) {
      return isSignedIn() && request.auth.uid in getClass(classId).studentIds;
    }

    // ---------------------------------------------------------
    // COLLECTIONS
    // ---------------------------------------------------------

    // 1. Users
    match /users/{userId} {
      function isValidUser(data) {
        return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
               data.email is string && data.email.size() > 0 && data.email.size() <= 256 &&
               data.role in ['teacher', 'student'] &&
               data.createdAt is string &&
               (data.get('photoURL', null) == null || data.photoURL is string);
      }

      allow get: if isSignedIn(); // Allow reading profile info (name, photo) for sync
      allow list: if false; // No searching users
      
      allow create: if isOwner(userId) && isValidUser(incoming());
      
      allow update: if isOwner(userId) && isValidUser(incoming()) &&
                    incoming().role == existing().role && // Protect role escalation
                    incoming().email == existing().email &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['name', 'createdAt', 'photoURL']);
    }

    // 2. Classes
    match /classes/{classId} {
      function isValidClass(data) {
        return data.className is string && data.className.size() > 0 && data.className.size() <= 100 &&
               data.teacherId is string && isValidId(data.teacherId) &&
               data.roomCode is string && data.roomCode.size() == 6 &&
               data.studentIds is list &&
               data.createdAt is string;
      }

      allow get: if isSignedIn();
      allow list: if isSignedIn(); // Allow discovery by roomCode. Privacy preserved by code mystery.

      allow create: if isSignedIn() && isValidClass(incoming()) && incoming().teacherId == request.auth.uid;
      
      allow update: if isSignedIn() && (
        // Teacher updates class meta
        (existing().teacherId == request.auth.uid && isValidClass(incoming()) && incoming().teacherId == existing().teacherId &&
         incoming().diff(existing()).affectedKeys().hasOnly(['className', 'roomCode', 'studentIds'])) ||
        // Student joins class (adds self to studentIds)
        (isValidClass(incoming()) && 
         incoming().diff(existing()).affectedKeys().hasOnly(['studentIds']) &&
         existing().teacherId == incoming().teacherId &&
         incoming().roomCode == existing().roomCode &&
         incoming().className == existing().className &&
         incoming().studentIds.size() >= existing().studentIds.size() &&
         request.auth.uid in incoming().studentIds)
      );

      allow delete: if isSignedIn() && existing().teacherId == request.auth.uid;

      // Problems subcollection
      match /problems/{problemId} {
         function isValidProblem(data) {
           return data.title is string && data.title.size() > 0 &&
                  data.description is string &&
                  data.language is string &&
                  (data.get('starterCode', null) == null || data.starterCode is string) &&
                  (data.get('instructionsUrl', null) == null || data.instructionsUrl is string) &&
                  data.createdAt is string;
         }

         allow read: if isTeacherOfClass(classId) || isStudentInClass(classId);
         allow create, update, delete: if isTeacherOfClass(classId) && isValidProblem(incoming());
      }

      // Resources subcollection
      match /resources/{resourceId} {
         allow read: if isTeacherOfClass(classId) || isStudentInClass(classId);
         allow create, update, delete: if isTeacherOfClass(classId);
      }

      // Submissions subcollection
      match /submissions/{submissionId} {
        function isValidSubmission(data) {
          return data.studentId == request.auth.uid &&
                 data.problemId is string &&
                 data.code is string &&
                 data.status in ['pending', 'correct', 'incorrect'] &&
                 data.submittedAt is string;
        }

        allow read: if isTeacherOfClass(classId) || (isSignedIn() && existing().studentId == request.auth.uid);
        
        allow create: if isStudentInClass(classId) && isValidSubmission(incoming());
        
        allow update: if (
          // Teacher providing feedback/status
          (isTeacherOfClass(classId) && 
           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'feedback'])) 
          || 
          // Student updating their OWN pending submission (rare case but allowed if schema stays safe)
          (isSignedIn() && existing().studentId == request.auth.uid && 
           existing().status == 'pending' && isValidSubmission(incoming()) &&
           incoming().diff(existing()).affectedKeys().hasOnly(['code', 'submittedAt']))
        );
      }

      // LiveCode subcollection
      match /liveCode/{studentId} {
        allow read: if isTeacherOfClass(classId) || isOwner(studentId);
        allow write: if isOwner(studentId);
      }
    }
  }
}
